import cv2
import numpy as np

def grayscale(img):
    return cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)   # VideoCapture는 BGR

def gaussian_blur(img, kernel_size):
    return cv2.GaussianBlur(img, (kernel_size, kernel_size), 1.5)

def canny(img, low_threshold, high_threshold):
    return cv2.Canny(img, low_threshold, high_threshold)

def region_of_interest(img, vertices):
    mask = np.zeros_like(img)
    ignore_mask_color = 255
    cv2.fillPoly(mask, vertices, ignore_mask_color)
    return cv2.bitwise_and(img, mask)

def draw_lines(img, lines, color=(0,0,255), thickness=5): 
    if lines is None: 
        return 
    for line in lines: 
        x1,y1,x2,y2 = line[0] 
        cv2.line(img, (x1,y1), (x2,y2), color, thickness)
def hough_lines(img, rho, theta, threshold, min_line_len, max_line_gap):
    lines = cv2.HoughLinesP(
        img, rho, theta, threshold,
        minLineLength=min_line_len,
        maxLineGap=max_line_gap
    )
    line_img = np.zeros((img.shape[0], img.shape[1], 3), dtype=np.uint8)
    draw_lines(line_img, lines)
    return line_img

def weighted_img(img, initial_img, a=0.8, b=1.0, c=0.0):
    return cv2.addWeighted(initial_img, a, img, b, c)

# ---- 영상 입력 ----
video_path = "curv.mp4"
cap = cv2.VideoCapture(video_path)
if not cap.isOpened():
    raise RuntimeError("비디오를 열 수 없음: " + video_path)

# (옵션) 저장 설정
save = False
writer = None

kernel_size = 5
low_threshold = 50
high_threshold = 200

rho = 2
theta = np.pi/180
threshold = 100
min_line_len = 120
max_line_gap = 200

# ===== 저장부 수정 시작 (여기만 변경) =====
fps = cap.get(cv2.CAP_PROP_FPS)
if fps <= 0:
    fps = 30

fourcc = cv2.VideoWriter_fourcc(*"mp4v")
# ===== 저장부 수정 끝 =====

while True:
    ret, frame = cap.read()
    if not ret:
        break

    h, w = frame.shape[:2]

    vertices = np.array([[
        (0, int(0.9*h)),
        (int(0*w), int(0.55*h)),
        (int(1*w), int(0.55*h)),
        (w, int(0.9*h))
    ]], dtype=np.int32)

    gray = grayscale(frame)
    blur_gray = gaussian_blur(gray, kernel_size)
    edges = canny(blur_gray, low_threshold, high_threshold)

    masked_edges = region_of_interest(edges, vertices)
    cv2.imshow("Edges", masked_edges)

    line_img = hough_lines(masked_edges, rho, theta, threshold,
                           min_line_len, max_line_gap)
    roi_vis = frame.copy()
    result = weighted_img(line_img, roi_vis, a=0.8, b=1.0, c=0.0)

    cv2.imshow("Lane detection", result)
    if cv2.waitKey(5) & 0xFF == ord('q'):
        break

    # ===== 저장부 수정 (writer 생성 위치만 변경) =====
    if save and writer is None:
        writer = cv2.VideoWriter("lane_out.mp4", fourcc, fps, (w, h))

    if save:
        writer.write(result)
    # ===== 여기까지 =====

cap.release()
if writer is not None:
    writer.release()
cv2.destroyAllWindows()
