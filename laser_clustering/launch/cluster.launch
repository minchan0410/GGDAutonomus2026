<launch>
    <param name="/use_sim_time" value="true" />

    <node name="clustering" pkg="laser_clustering" type="clustering" output="screen" />
    <node name="occ_grid" pkg="laser_clustering" type="occ_grid" output="screen" />
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find laser_clustering)/rviz/clustering.rviz" />
</launch>